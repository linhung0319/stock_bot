{
  // stock bot：規則引擎、排程、網站、LINE（design_v2 §2.7）
  // 金鑰一律用 `wrangler secret put`，不寫在這裡：
  //   ADMIN_TOKEN        管理端點（/admin/*）的 Bearer token（在 Cloudflare Access 設好之前用）
  //   AI_TASK_SECRET     雲端排程取證據包、送回結果用的 Bearer token（和 claude.ai 雲端環境的 network secret 相同）
  //   ROUTINE_FIRE_URL   雲端排程的 /fire 網址
  //   ROUTINE_TOKEN      雲端排程的 API token
  //   EDGAR_USER_AGENT   SEC 要求的 User-Agent（含聯絡方式）
  //   ACCESS_TEAM_DOMAIN Cloudflare Access 的團隊網域（xxx.cloudflareaccess.com）
  //   ACCESS_AUD         Access 應用程式的 AUD；這兩個都設了，網站（/api、/demo/api）才用 Access 驗證登入
  "name": "stock-bot",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  // 網站的靜態檔（public/）。符合檔名的請求由 Cloudflare 直接回應；其他（/api、/admin、/ai…）才進 Worker
  "assets": { "directory": "./public" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stock-bot",
      "database_id": "a0bdb989-0a39-4d7f-83fb-5b1c587a10de",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    // T4 實測：美股收盤後（UTC 23:05、23:10，週一到週五）各跑一半，避開免費方案每次 50 個對外請求的上限
    // T6 每日資料抓取：UTC 23:30（美東 18:30 或 19:30，收盤後）
    "crons": ["5,10 23 * * 1-5", "30 23 * * 1-5"]
  }
}
